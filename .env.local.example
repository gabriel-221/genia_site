# ============================================================
# G.E.N.I.A — Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local com valores reais.
# ============================================================

# ----------------------------------------------------------
# Supabase
# Obter em: Painel Supabase → Project Settings → API
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# ----------------------------------------------------------
# Anthropic (Claude Haiku — GENIA Copilot)
# Obter em: console.anthropic.com → API Keys
# Esta chave permanece no servidor (sem prefixo NEXT_PUBLIC_)
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-SUA_CHAVE_AQUI
